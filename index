<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>The Trust Spectrum — The French Revolution</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,700&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<!-- Lenis smooth scroll -->
<script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

<style>
/* ══════════════════════════════════════
   TOKENS
══════════════════════════════════════ */
:root {
  --black:   #05050a;
  --off-w:   #f0ede4;
  --warm-w:  #e2ddd0;
  --grey:    #58564e;
  --dim:     rgba(240,237,228,0.45);
  --gold:    #c8b89a;
  --gold-dk: #8a7a62;
  --red:     #c8342a;
  --dot-in:  #e8724a;
  --dot-cit: #7b8fe0;
  --dot-hum: #4db890;
  --fd: 'Cormorant Garamond', Georgia, serif;
  --fm: 'DM Mono', monospace;
  --fb: 'DM Sans', sans-serif;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{font-size:16px;}
body{background:var(--black);color:var(--off-w);font-family:var(--fb);overflow-x:hidden;}

/* ══════════════════════════════════════
   PROGRESS BAR
══════════════════════════════════════ */
#pb{
  position:fixed;top:0;left:0;height:2px;width:0%;
  background:linear-gradient(90deg,var(--dot-in),var(--dot-cit),var(--dot-hum));
  z-index:500;pointer-events:none;transition:width .08s linear;
}

/* ══════════════════════════════════════
   LANG TOGGLE
══════════════════════════════════════ */
#lang-bar{
  position:fixed;top:0;left:0;right:0;z-index:400;
  display:flex;justify-content:flex-end;padding:16px 20px;
  background:linear-gradient(to bottom,rgba(5,5,10,.9) 0%,transparent 100%);
  pointer-events:none;
}
#lang-toggle{
  display:flex;border:1px solid rgba(200,184,154,.3);border-radius:3px;
  overflow:hidden;pointer-events:all;
}
.lb{
  background:transparent;border:none;padding:6px 14px;
  font-family:var(--fm);font-size:10px;letter-spacing:.15em;
  color:var(--grey);cursor:pointer;transition:all .2s;
}
.lb.on{background:var(--gold);color:var(--black);}

/* ══════════════════════════════════════
   TIMELINE
══════════════════════════════════════ */
#tl{
  position:fixed;left:20px;top:50%;transform:translateY(-50%);
  z-index:300;display:flex;flex-direction:column;align-items:flex-start;
}
.tl-i{display:flex;flex-direction:column;align-items:flex-start;position:relative;}
.tl-d{
  width:7px;height:7px;border-radius:50%;
  border:1.5px solid rgba(200,184,154,.2);background:transparent;
  transition:all .4s;flex-shrink:0;
}
.tl-d.on{border-color:var(--gold);background:var(--gold);box-shadow:0 0 8px rgba(200,184,154,.4);}
.tl-d.done{border-color:rgba(200,184,154,.35);background:rgba(200,184,154,.15);}
.tl-c{width:1px;height:44px;margin-left:3px;background:rgba(200,184,154,.12);position:relative;overflow:hidden;}
.tl-cf{position:absolute;top:0;left:0;right:0;height:0%;background:var(--gold);transition:height .5s ease;}
.tl-l{
  position:absolute;left:16px;top:-2px;
  font-family:var(--fm);font-size:8px;letter-spacing:.2em;text-transform:uppercase;
  color:rgba(200,184,154,.2);white-space:nowrap;transition:color .4s;pointer-events:none;
}
.tl-l.on{color:var(--gold);}
@media(max-width:600px){#tl{left:10px;}.tl-l{display:none;}.tl-c{height:30px;}}

/* ══════════════════════════════════════
   GLOBAL FILM GRAIN + VIGNETTE
══════════════════════════════════════ */
#grain{
  position:fixed;inset:0;z-index:200;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.055'/%3E%3C/svg%3E");
  background-size:256px;opacity:.45;mix-blend-mode:overlay;
}
#vignette{
  position:fixed;inset:0;z-index:199;pointer-events:none;
  background:radial-gradient(ellipse at 50% 50%,transparent 25%,rgba(5,5,10,.75) 100%);
}

/* ══════════════════════════════════════
   FULLSCREEN SCENES (Hook, Lesson, Handoff)
══════════════════════════════════════ */
.fs{
  position:relative;min-height:100vh;
  display:flex;align-items:center;justify-content:center;
  padding:90px 72px;overflow:hidden;
}
@media(max-width:600px){.fs{padding:80px 24px 80px 48px;}}

.fs-bg{
  position:absolute;inset:0;z-index:0;
  background-size:cover;background-position:center;
  transition:opacity 1s ease;
}
.fs-bg::after{
  content:'';position:absolute;inset:0;
  background:rgba(5,5,10,.72);
}

.fs-inner{position:relative;z-index:10;max-width:700px;width:100%;}

/* ── text reveal: tied to scroll not auto ── */
.sr{
  opacity:0;transform:translateY(22px);
  transition:opacity .55s cubic-bezier(.22,1,.36,1),transform .55s cubic-bezier(.22,1,.36,1);
}
.sr.in{opacity:1;transform:translateY(0);}
.sr.out{opacity:0;transform:translateY(-14px);transition-duration:.3s;}
.sr[data-d="1"]{transition-delay:.1s;}
.sr[data-d="2"]{transition-delay:.22s;}
.sr[data-d="3"]{transition-delay:.36s;}
.sr[data-d="4"]{transition-delay:.52s;}
.sr[data-d="5"]{transition-delay:.70s;}

/* ── hook typography ── */
.overline{
  font-family:var(--fm);font-size:9px;letter-spacing:.35em;text-transform:uppercase;
  color:rgba(200,184,154,.45);margin-bottom:2rem;display:block;
}
.h-giant{
  font-family:var(--fd);font-size:clamp(2.2rem,5.5vw,4.4rem);
  font-weight:300;font-style:italic;line-height:1.18;
  color:var(--off-w);margin-bottom:.55em;
}
.h-giant em{font-style:normal;font-weight:700;color:var(--gold);}
.h-sub{
  font-family:var(--fd);font-size:clamp(1.05rem,2.4vw,1.4rem);
  font-weight:300;font-style:italic;color:var(--dim);line-height:1.6;
}

/* scroll cue */
.scroll-cue{
  position:absolute;bottom:28px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;z-index:20;
}
.scroll-cue span{font-family:var(--fm);font-size:8px;letter-spacing:.35em;text-transform:uppercase;color:var(--grey);}
.sc-line{
  width:1px;height:36px;
  background:linear-gradient(to bottom,var(--grey),transparent);
  animation:scAnim 2s ease-in-out infinite;
}
@keyframes scAnim{0%,100%{opacity:.5;transform:scaleY(1)}50%{opacity:.1;transform:scaleY(.3)}}

/* ── lesson typography ── */
.l-line{
  font-family:var(--fd);font-size:clamp(1.3rem,3.2vw,2rem);
  font-weight:300;font-style:italic;line-height:1.65;
  color:var(--off-w);margin-bottom:.55em;
}
.l-line em{font-style:normal;font-weight:700;color:var(--dot-in);}
.l-q{
  font-family:var(--fd);font-size:clamp(1.2rem,2.8vw,1.75rem);
  font-weight:400;font-style:italic;color:var(--gold);
  border-top:1px solid rgba(200,184,154,.12);padding-top:1.4em;margin-top:.4em;
  line-height:1.5;
}

/* ── handoff ── */
.hf-t{
  font-family:var(--fd);font-size:clamp(2rem,5.5vw,4rem);
  font-weight:700;line-height:1.05;color:var(--off-w);margin-bottom:.8rem;
}
.hf-b{font-family:var(--fb);font-size:.9rem;color:var(--dim);line-height:1.75;margin-bottom:1.8rem;}
.pips{display:flex;gap:6px;margin-bottom:1.4rem;}
.pip{width:6px;height:6px;border-radius:50%;background:rgba(200,184,154,.18);}
.pip.on{background:var(--gold);}
.go-btn{
  display:inline-flex;align-items:center;gap:10px;padding:14px 28px;
  border:1.5px solid var(--gold);border-radius:3px;background:transparent;
  color:var(--off-w);font-family:var(--fm);font-size:11px;
  letter-spacing:.15em;text-transform:uppercase;cursor:pointer;
  text-decoration:none;transition:all .25s;
}
.go-btn:hover{background:var(--gold);color:var(--black);}
.go-arr{transition:transform .2s;}
.go-btn:hover .go-arr{transform:translateX(5px);}

/* ══════════════════════════════════════
   EXHIBIT CHAPTERS
   Sticky artifact + scrolling annotations
══════════════════════════════════════ */
.ch{position:relative;}/* height set by JS */

.sticky-stage{
  position:sticky;top:0;height:100vh;overflow:hidden;
}

/* full-bleed chapter background image */
.ch-bg{
  position:absolute;inset:0;z-index:0;
  background-size:cover;background-position:center;
}
.ch-bg::after{
  content:'';position:absolute;inset:0;
  background:rgba(5,5,10,.65);
}

/* ── central artifact ── */
.artifact-frame{
  position:absolute;inset:0;z-index:10;
  display:flex;align-items:center;justify-content:center;
  pointer-events:none;
}
/* All per-stop artifact images layered, crossfade between them */
.artifact-img{
  position:absolute;
  max-height:78vh;max-width:48vw;
  width:auto;height:auto;object-fit:contain;
  filter:sepia(.3) contrast(.88) brightness(.8);
  box-shadow:0 0 120px rgba(0,0,0,.9),0 0 40px rgba(0,0,0,.7);
  border:1px solid rgba(200,184,154,.07);
  opacity:0;
  transition:opacity .7s cubic-bezier(.22,1,.36,1);
  animation:artFloat 9s ease-in-out infinite;
  transform-origin:center;
}
.artifact-img.show{opacity:1;}
@keyframes artFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@media(max-width:768px){.artifact-img{max-width:82vw;max-height:42vh;}}

/* side images */
.side-img{
  position:absolute;z-index:15;
  width:clamp(110px,14vw,200px);height:auto;
  object-fit:cover;
  filter:sepia(.45) contrast(.82) brightness(.65);
  border:1px solid rgba(200,184,154,.1);
  box-shadow:0 8px 40px rgba(0,0,0,.75);
  opacity:0;transform:scale(.94);
  transition:opacity .5s ease,transform .5s ease;
  aspect-ratio:4/3;
}
.side-img.show{opacity:1;transform:scale(1);}
.side-left{left:5%;top:50%;transform:translateY(-50%) scale(.94);}
.side-left.show{transform:translateY(-50%) scale(1);}
.side-right{right:5%;top:50%;transform:translateY(-50%) scale(.94);}
.side-right.show{transform:translateY(-50%) scale(1);}

/* ── spotlight ── */
.spotlight{
  position:absolute;z-index:20;border-radius:50%;
  background:radial-gradient(ellipse,rgba(200,184,154,.16) 0%,transparent 68%);
  pointer-events:none;opacity:0;
  transition:opacity .5s ease,left .7s cubic-bezier(.22,1,.36,1),top .7s cubic-bezier(.22,1,.36,1),width .5s,height .5s;
}
.spotlight.on{opacity:1;}

/* ── annotation card ── */
.anno-layer{
  position:absolute;inset:0;z-index:30;
  display:flex;align-items:center;justify-content:flex-end;
  padding:80px 5% 80px 52%;pointer-events:none;
}
@media(max-width:768px){
  .anno-layer{padding:auto 5% 24px 5%;align-items:flex-end;}
}
.anno-card{
  max-width:400px;width:100%;
  opacity:0;transform:translateX(28px);
  transition:opacity .5s cubic-bezier(.22,1,.36,1),transform .5s cubic-bezier(.22,1,.36,1);
  pointer-events:all;
}
.anno-card.on{opacity:1;transform:translateX(0);}

.anno-inner{
  background:rgba(5,5,10,.78);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(200,184,154,.11);border-radius:6px;
  padding:26px 26px 22px;position:relative;overflow:hidden;
}
.anno-inner::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(200,184,154,.28),transparent);
}

.a-tag{
  font-family:var(--fm);font-size:8px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--gold);margin-bottom:11px;display:flex;align-items:center;gap:8px;
}
.a-tag::after{content:'';flex:1;height:1px;background:rgba(200,184,154,.13);}

.a-head{
  font-family:var(--fd);font-size:clamp(1.4rem,2.8vw,2rem);
  font-weight:600;line-height:1.12;color:var(--off-w);margin-bottom:11px;
}
.a-head em{font-style:italic;font-weight:300;color:var(--gold);}
.a-head strong{color:var(--dot-in);}

/* FIX 4: body text much more readable — brighter, larger */
.a-body{font-family:var(--fb);font-size:.92rem;line-height:1.75;color:rgba(240,237,228,.82);margin-bottom:14px;}

/* FIX 2: sentence-by-sentence reveal */
.a-sent{
  display:block;
  opacity:0;transform:translateY(10px);
  transition:opacity .45s cubic-bezier(.22,1,.36,1), transform .45s cubic-bezier(.22,1,.36,1);
  margin-bottom:.35em;
}
.a-sent.in{opacity:1;transform:translateY(0);}

/* FIX 4: fact text brighter */
.a-fact{
  font-family:var(--fm);font-size:.72rem;
  color:rgba(200,184,154,.68);border-top:1px solid rgba(200,184,154,.12);
  padding-top:11px;line-height:1.65;
}

/* Score scale note — correct axis */
.sc-scale-note{
  font-family:var(--fm);font-size:.62rem;letter-spacing:.06em;
  color:rgba(200,184,154,.5);margin-bottom:10px;line-height:1.5;
  border-left:2px solid rgba(200,184,154,.2);padding-left:8px;
}
/* Score consequence sentence under each bar */
.sc-sentence{
  font-family:var(--fd);font-size:.85rem;font-style:italic;font-weight:300;
  color:rgba(240,237,228,.72);line-height:1.5;
  margin:-4px 0 12px 0;padding-left:8px;
  border-left:2px solid rgba(200,184,154,.15);
}
/* Claimed vs Actual comparison header */
.sc-compare-hdr{
  display:flex;gap:8px;align-items:center;
  font-family:var(--fm);font-size:7px;letter-spacing:.25em;text-transform:uppercase;
  margin-bottom:6px;margin-top:14px;
}
.sc-compare-hdr span{ padding:2px 8px;border-radius:2px; }
.sc-compare-hdr .claimed-lbl{ background:rgba(123,143,224,.15);color:var(--dot-cit); }
.sc-compare-hdr .actual-lbl{  background:rgba(232,114,74,.15); color:var(--dot-in);  }
.sc-compare-hdr .arrow-lbl{   color:var(--grey); font-size:10px; }

/* ══════════════════════════════════════
   CINEMATIC MAP — Tactical War Table 1792
══════════════════════════════════════ */
.map-scene{
  position:absolute;inset:0;z-index:10;
  display:flex;align-items:center;justify-content:center;
  pointer-events:none;
}
.map-stack{
  position:relative;
  width:min(56vw,540px);
  animation:artFloat 12s ease-in-out infinite;
  transform-origin:center;
  transition:transform 1.8s cubic-bezier(.22,1,.36,1);
}
/* Layer 1: real map photo — darkened, high contrast */
.map-photo{
  width:100%;height:auto;display:block;
  filter:sepia(.5) contrast(1.2) brightness(.5);
  border:1px solid rgba(200,184,154,.12);
  box-shadow:0 0 80px rgba(0,0,0,.9),0 0 200px rgba(0,0,0,.7);
}
/* Layer 2: SVG arrows — mix-blend-mode:multiply paints into the paper */
.map-svg-overlay{
  position:absolute;inset:0;width:100%;height:100%;
  overflow:visible;
}
/* Layer 3: tactical vignette */
.map-vignette{
  position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse at 48% 52%, transparent 28%, rgba(5,5,10,.72) 78%);
}
/* Floating labels — positioned by JS, parallax shift applied */
.map-label-float{
  position:absolute;
  font-family:'Cormorant Garamond',Georgia,serif;
  font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  pointer-events:none;white-space:nowrap;
  font-size:clamp(.6rem,1.1vw,.9rem);
  text-shadow:0 1px 4px rgba(0,0,0,.8);
  transition:color .5s ease, text-shadow .5s ease, opacity .5s ease;
}
.map-label-float.lbl-paris{color:rgba(200,184,154,.9);}
.map-label-float.lbl-paris.danger{
  color:rgba(230,60,60,.95);
  animation:parisPulse 1.2s ease-in-out infinite;
  text-shadow:0 0 18px rgba(230,60,60,.7),0 0 40px rgba(230,60,60,.3);
}
@keyframes parisPulse{0%,100%{text-shadow:0 0 12px rgba(230,60,60,.6)}50%{text-shadow:0 0 28px rgba(230,60,60,1),0 0 55px rgba(230,60,60,.4)}}
.map-label-float.lbl-enemy{color:rgba(160,40,40,0);font-size:clamp(.55rem,1vw,.8rem);}
.map-label-float.lbl-enemy.show{color:rgba(190,55,55,.95);}

/* Paris dot */
.paris-dot{fill:rgba(200,184,154,.85);animation:pdotPulse 2.5s ease-in-out infinite;}
@keyframes pdotPulse{0%,100%{r:4;opacity:.85}50%{r:6;opacity:.4}}
.paris-dot.danger{fill:rgba(220,60,60,.9);}

/* Ink-bleed invasion arrows */
.map-inv-arrow{
  stroke:#9b1515;stroke-width:4.5;fill:none;
  stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:320;stroke-dashoffset:320;
  mix-blend-mode:multiply;
  filter:url(#ink-bleed);
  transition:stroke-dashoffset 2.4s cubic-bezier(.22,1,.36,1), opacity .6s ease;
  opacity:0;
}
.map-inv-arrow.draw{stroke-dashoffset:0;opacity:1;}
.map-inv-arrow.hide{opacity:0 !important;transition:opacity .4s ease;}
.map-inv-head{
  fill:#9b1515;opacity:0;mix-blend-mode:multiply;filter:url(#ink-bleed);
  transition:opacity .5s ease 2.2s;
}
.map-inv-head.draw{opacity:.9;}
.map-inv-head.hide{opacity:0 !important;transition:opacity .3s ease;}

/* Victory arrows */
.map-vic-arrow{
  stroke:#1a5c35;stroke-width:3.5;fill:none;
  stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:240;stroke-dashoffset:240;
  mix-blend-mode:multiply;
  filter:url(#ink-bleed);
  transition:stroke-dashoffset 1.8s cubic-bezier(.22,1,.36,1), opacity .5s ease;
  opacity:0;
}
.map-vic-arrow.draw{stroke-dashoffset:0;opacity:1;}
.map-vic-head{fill:#1a5c35;opacity:0;mix-blend-mode:multiply;transition:opacity .5s ease 1.5s;}
.map-vic-head.draw{opacity:.9;}
.sc-block{margin-top:6px;}
.sc-row{display:flex;align-items:center;gap:7px;margin-bottom:9px;}
.sc-lbl{font-family:var(--fm);font-size:8px;letter-spacing:.13em;text-transform:uppercase;min-width:76px;}
.sc-lbl.in{color:var(--dot-in);}
.sc-lbl.cit{color:var(--dot-cit);}
.sc-lbl.hum{color:var(--dot-hum);}
.sc-num{font-family:var(--fm);font-size:1.15rem;font-weight:500;min-width:28px;text-align:right;}
.sc-num.in{color:var(--dot-in);}
.sc-num.cit{color:var(--dot-cit);}
.sc-num.hum{color:var(--dot-hum);}
.sc-trk{flex:1;height:2px;background:rgba(255,255,255,.07);border-radius:2px;overflow:hidden;}
.sc-fill{height:100%;width:0%;border-radius:2px;transition:width 1.4s cubic-bezier(.22,1,.36,1);}
.sc-fill.in{background:linear-gradient(90deg,rgba(232,114,74,.3),var(--dot-in));}
.sc-fill.cit{background:linear-gradient(90deg,rgba(123,143,224,.3),var(--dot-cit));}
.sc-fill.hum{background:linear-gradient(90deg,rgba(77,184,144,.3),var(--dot-hum));}
.sc-delta{
  font-family:var(--fm);font-size:.62rem;padding:1px 6px;border-radius:2px;
}
.sc-delta.neg{background:rgba(200,50,50,.12);color:#e05555;border:1px solid rgba(200,50,50,.2);}
.sc-delta.pos{background:rgba(77,184,144,.12);color:var(--dot-hum);border:1px solid rgba(77,184,144,.2);}

/* dot defs */
.dot-defs{display:flex;flex-direction:column;gap:1.1rem;margin-top:6px;}
.dd-item{display:flex;gap:.9rem;align-items:flex-start;}
.dd-circ{width:11px;height:11px;border-radius:50%;flex-shrink:0;margin-top:4px;}
.dd-circ.in{background:var(--dot-in);box-shadow:0 0 8px rgba(232,114,74,.4);}
.dd-circ.cit{background:var(--dot-cit);box-shadow:0 0 8px rgba(123,143,224,.4);}
.dd-circ.hum{background:var(--dot-hum);box-shadow:0 0 8px rgba(77,184,144,.4);}
.dd-name{font-family:var(--fm);font-size:8px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:2px;}
.dd-def{font-family:var(--fd);font-size:1.05rem;font-style:italic;font-weight:300;line-height:1.35;}

/* names list */
.names{display:flex;flex-direction:column;gap:5px;margin-top:8px;}
.name-row{
  display:flex;align-items:baseline;gap:8px;font-family:var(--fm);font-size:.72rem;color:var(--dim);
  opacity:0;transform:translateX(-8px);
  transition:opacity .35s ease, transform .35s ease;
}
.name-row.nm-in{opacity:1;transform:translateX(0);}
