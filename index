/* ── SCORE BLOCK BUILDER ── */
function mkScoreBlock(key, inclLabel){
  const d = SCORES[key];
  const wrap = el('div','sc-block');
  if(inclLabel){
    const lbl=el('div','a-fact'); txt(lbl, d.lbl.en, d.lbl.jp); lbl.style.marginBottom='8px';
    wrap.appendChild(lbl);
  }
  // Score axis — correct direction per Trust Spectrum spec
  const note = el('div','sc-scale-note');
  txt(note,
    '← 0 = selfish, unchallengeable · kind, self-doubting = 100 →',
    '← 0 = 利己的・疑いなし · 善良・自己批判的 = 100 →'
  );
  wrap.appendChild(note);

  d.rows.forEach(row => {
    const r=el('div','sc-row');
    const ln=el('span','sc-lbl '+row.k);
    txt(ln, {in:'THEMSELVES',cit:'CITIZENS',hum:'ALL HUMANS'}[row.k],
            {in:'権力者自身',cit:'市民',hum:'全人類'}[row.k]);
    const num=el('span','sc-num '+row.k); num.textContent='0'; num.dataset.target=row.v;
    const trk=el('div','sc-trk');
    const fill=el('div','sc-fill '+row.k); fill.dataset.target=row.v; trk.appendChild(fill);
    r.appendChild(ln); r.appendChild(num); r.appendChild(trk);
    if(row.delta!==undefined){
      const dEl=el('span','sc-delta '+(row.delta<0?'neg':'pos'));
      dEl.textContent=(row.delta>0?'+':'')+row.delta; r.appendChild(dEl);
    }
    wrap.appendChild(r);
    // Consequence sentence beneath each bar
    const sent=el('p','sc-sentence');
    txt(sent, row.en, row.jp);
    wrap.appendChild(sent);
  });
  return wrap;
}

/* ── ANNOTATION CARD BUILDER ── */
function mkCard(stop, scIdx, si){
  const card = el('div','anno-card'); card.id='card-'+scIdx+'-'+si;
  const inner = el('div','anno-inner');

  const langData = stop[lang]||stop.en;
  const jpData   = stop.jp||stop.en;
  const enData   = stop.en;

  // Tag
  const tag=el('div','a-tag'); txt(tag, enData.tag, jpData.tag); inner.appendChild(tag);

  // Headline
  const head=el('h2','a-head');
  txt(head, enData.h.replace(/\n/g,'<br>'), jpData.h.replace(/\n/g,'<br>'));
  inner.appendChild(head);

  // Dot defs (before score reveal in Before chapter)
  if(stop.dotDefs){
    const dw=el('div','dot-defs');
    DOT_DEFS.forEach((d,di)=>{
      const it=el('div','dd-item');
      const c=el('div','dd-circ '+d.k);
      const tx=el('div');
      const nm=el('div','dd-name'); txt(nm,d.en.nm,d.jp.nm);
      const df=el('div','dd-def'); txt(df,d.en.df,d.jp.df);
      tx.appendChild(nm); tx.appendChild(df);
      it.appendChild(c); it.appendChild(tx); dw.appendChild(it);
    });
    inner.appendChild(dw);
  }

  // Body — split into sentences for scroll-reveal
  if(enData.body && !stop.names){
    const enSentences = enData.body.split(/(?<=[.!?—])\s+/).filter(Boolean);
    const jpBody = jpData.body || '';
    const jpSentences = jpBody.match(/[^。！？]*[。！？]/g) || [jpBody];
    // Use EN sentence count but cap JP index — never repeat last JP sentence
    const count = enSentences.length;
    const bodyWrap = el('div','a-body');
    enSentences.forEach((sent, si2)=>{
      const span = el('span','a-sent');
      span.dataset.en = sent;
      span.dataset.jp = jpSentences[si2] !== undefined ? jpSentences[si2] : '';
      span.innerHTML = sent;
      bodyWrap.appendChild(span);
    });
    inner.appendChild(bodyWrap);
  }

  // Names list
  if(stop.names){
    const nl=el('div','names');
    NAMES.forEach((n,ni)=>{
      const r=el('div','name-row'+(n.x?' x':'')+(n.hi?' hi':''));
      r.dataset.nameIdx = ni;
      const dt=el('span','name-dt'); dt.textContent=n.dt;
      const nm=el('span','name-nm'); nm.textContent=n.nm;
      r.appendChild(dt); r.appendChild(nm);
      if(n.note){const nt=el('span','name-note');nt.textContent='— '+n.note;r.appendChild(nt);}
      nl.appendChild(r);
    });
    inner.appendChild(nl);
  }

  // Scores — single set
  if(stop.scores){
    inner.appendChild(mkScoreBlock(stop.scores, true));
  }

  // Scores — claimed vs actual comparison (Terror stop)
  if(stop.scores_compare){
    // Claimed header
    const cmpHdr1 = el('div','sc-compare-hdr');
    cmpHdr1.innerHTML = '<span class="claimed-lbl" data-en="WHAT HE CLAIMED" data-jp="主張">WHAT HE CLAIMED</span>';
    inner.appendChild(cmpHdr1);
    inner.appendChild(mkScoreBlock('robespierre_claimed', false));

    const cmpHdr2 = el('div','sc-compare-hdr');
    cmpHdr2.innerHTML = '<span class="arrow-lbl">↓</span><span class="actual-lbl" data-en="WHAT HE DID · FOUR YEARS LATER" data-jp="四年後の現実">WHAT HE DID · FOUR YEARS LATER</span>';
    inner.appendChild(cmpHdr2);
    inner.appendChild(mkScoreBlock('actual', false));
  }

  // Fact
  if(enData.fact && !stop.scores){
    const f=el('p','a-fact'); txt(f, enData.fact, jpData.fact); inner.appendChild(f);
  }

  card.appendChild(inner);
  return card;
}

/* ── BUILD CINEMATIC MAP ──
   Based on reference war map (france-1792-revolution-in-danger)
   Homann map 1196×992. Key coordinates derived from reference:
   Paris:   ~x:686, y:292  (57.4% × 29.4%)
   Belgium/invasion corridor: top-right, x:780-1100, y:55-320
   Rhine/Austrian zone: far right, x:980-1160, y:200-600
   Vendée:  bottom-left interior, x:310-480, y:500-720
   Expansion zones: beyond all borders after victory
─────────────────────────────────────────────────── */
function mkMap(){
  const ns = 'http://www.w3.org/2000/svg';
  const VW = 1196, VH = 992;

  const stack = el('div','map-stack'); stack.id='map-stack';

  // Layer 1: map photo
  const photo = el('img','map-photo');
  photo.src = './france-map.jpg';
  photo.alt = 'Homann antique map of France 1720';
  photo.loading = 'lazy';
  photo.onerror = () => { photo.src = './valmy.jpg'; };
  stack.appendChild(photo);

  // Layer 2: SVG overlay
  const svg = document.createElementNS(ns,'svg');
  svg.setAttribute('viewBox',`0 0 ${VW} ${VH}`);
  svg.setAttribute('xmlns',ns);
  svg.setAttribute('preserveAspectRatio','xMidYMid meet');
  svg.classList.add('map-svg-overlay');

  const defs = document.createElementNS(ns,'defs');

  // Ink-bleed filter for all zones
  const filt = document.createElementNS(ns,'filter');
  filt.setAttribute('id','ink-bleed');
  filt.setAttribute('x','-8%'); filt.setAttribute('y','-8%');
  filt.setAttribute('width','116%'); filt.setAttribute('height','116%');
  const turb = document.createElementNS(ns,'feTurbulence');
  turb.setAttribute('type','turbulence');
  turb.setAttribute('baseFrequency','0.022 0.038');
  turb.setAttribute('numOctaves','4');
  turb.setAttribute('seed','7');
  turb.setAttribute('result','noise');
  const disp = document.createElementNS(ns,'feDisplacementMap');
  disp.setAttribute('in','SourceGraphic');
  disp.setAttribute('in2','noise');
  disp.setAttribute('scale','22');
  disp.setAttribute('xChannelSelector','R');
  disp.setAttribute('yChannelSelector','G');
  filt.appendChild(turb); filt.appendChild(disp);
  defs.appendChild(filt);
  svg.appendChild(defs);

  /* ── INVASION ZONE ── bright red, NE corner */
  const invZone = document.createElementNS(ns,'polygon');
  invZone.setAttribute('id','inv-zone');
  invZone.setAttribute('points',
    `${VW},0 ${VW},${VH*0.65} ${VW*0.82},${VH*0.58} ${VW*0.78},${VH*0.44}
     ${VW*0.72},${VH*0.36} ${VW*0.62},${VH*0.28} ${VW*0.56},${VH*0.22}
     ${VW*0.68},${VH*0.05} ${VW},0`
  );
  invZone.setAttribute('fill','#dd1111');
  invZone.setAttribute('opacity','0');
  invZone.setAttribute('filter','url(#ink-bleed)');
  invZone.style.mixBlendMode = 'multiply';
  invZone.style.transition = 'opacity .8s ease';
  svg.appendChild(invZone);

  /* ── INVASION ARROWS — red, pointing SW toward Paris ── */
  const invArrows = [
    { id:'iarr-prussia', d:`M ${VW*0.92},${VH*0.12} L ${VW*0.82},${VH*0.22} L ${VW*0.72},${VH*0.30}`,
      hx:VW*0.72, hy:VH*0.30, hdx:-10, hdy:8 },
    { id:'iarr-austria', d:`M ${VW*0.96},${VH*0.40} L ${VW*0.84},${VH*0.38} L ${VW*0.74},${VH*0.34}`,
      hx:VW*0.74, hy:VH*0.34, hdx:-10, hdy:-2 },
    { id:'iarr-britain', d:`M ${VW*0.38},${VH*0.10} L ${VW*0.48},${VH*0.18} L ${VW*0.57},${VH*0.25}`,
      hx:VW*0.57, hy:VH*0.25, hdx:9, hdy:7 },
    { id:'iarr-south', d:`M ${VW*0.90},${VH*0.55} L ${VW*0.80},${VH*0.48} L ${VW*0.72},${VH*0.40}`,
      hx:VW*0.72, hy:VH*0.40, hdx:-8, hdy:-8 },
  ];
  invArrows.forEach(a=>{
    const path = document.createElementNS(ns,'path');
    path.setAttribute('id', a.id);
    path.setAttribute('d', a.d);
    path.setAttribute('stroke','#cc1111');
    path.setAttribute('stroke-width','5');
    path.setAttribute('fill','none');
    path.setAttribute('stroke-linecap','round');
    path.setAttribute('stroke-linejoin','round');
    path.setAttribute('filter','url(#ink-bleed)');
    path.style.mixBlendMode = 'multiply';
    path.style.opacity = '0';
    path.style.strokeDasharray = '260';
    path.style.strokeDashoffset = '260';
    path.style.transition = 'opacity .4s ease';
    svg.appendChild(path);
    // Arrowhead: tip at (hx,hy), direction given by (hdx,hdy) unit vector
    const poly = document.createElementNS(ns,'polygon');
    poly.setAttribute('id', a.id+'-head');
    const tx=a.hx, ty=a.hy;
    const len=Math.sqrt(a.hdx*a.hdx+a.hdy*a.hdy)||1;
    const ux=a.hdx/len, uy=a.hdy/len; // unit forward
    const px=-uy, py=ux; // perpendicular
    const sz=16;
    const pts=`${tx},${ty} ${tx-ux*sz+px*sz*0.5},${ty-uy*sz+py*sz*0.5} ${tx-ux*sz-px*sz*0.5},${ty-uy*sz-py*sz*0.5}`;
    poly.setAttribute('points', pts);
    poly.setAttribute('fill','#cc1111');
    poly.setAttribute('filter','url(#ink-bleed)');
    poly.style.mixBlendMode = 'multiply';
    poly.style.opacity = '0';
    poly.style.transition = 'opacity .3s ease';
    svg.appendChild(poly);
  });

  /* ── VICTORY EXPANSION ZONES ──
