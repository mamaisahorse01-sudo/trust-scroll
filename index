    { id:'exp-rhine', pts:`${VW*0.86},${VH*0.20} ${VW},${VH*0.20} ${VW},${VH*0.60} ${VW*0.86},${VH*0.52}` },
    // Savoy/Nice SE
    { id:'exp-savoy', pts:`${VW*0.76},${VH*0.63} ${VW*0.90},${VH*0.66} ${VW*0.93},${VH*0.83} ${VW*0.82},${VH*0.89} ${VW*0.74},${VH*0.78}` },
  ];
  expansionZones.forEach(ez=>{
    const p = document.createElementNS(ns,'polygon');
    p.setAttribute('id', ez.id);
    p.setAttribute('points', ez.pts);
    p.setAttribute('fill','#1040aa');
    p.setAttribute('opacity','0');
    p.setAttribute('filter','url(#ink-bleed)');
    p.setAttribute('clip-path',`url(#${vicClipId})`);
    p.style.mixBlendMode = 'multiply';
    p.style.transition = 'opacity .6s ease';
    svg.appendChild(p);
  });

  /* ── VICTORY ARROWS — blue, pushing outward from France like WWII map ── */
  const vicArrows = [
    { id:'varr-ne', d:`M ${VW*0.68},${VH*0.22} L ${VW*0.82},${VH*0.10} L ${VW*0.92},${VH*0.05}`,
      hx:VW*0.92, hy:VH*0.05, hdx:10, hdy:-5 },
    { id:'varr-e',  d:`M ${VW*0.78},${VH*0.40} L ${VW*0.90},${VH*0.36} L ${VW*0.98},${VH*0.33}`,
      hx:VW*0.98, hy:VH*0.33, hdx:8, hdy:-3 },
    { id:'varr-se', d:`M ${VW*0.76},${VH*0.63} L ${VW*0.87},${VH*0.70} L ${VW*0.92},${VH*0.78}`,
      hx:VW*0.92, hy:VH*0.78, hdx:5, hdy:8 },
    { id:'varr-n',  d:`M ${VW*0.62},${VH*0.15} L ${VW*0.70},${VH*0.06} L ${VW*0.76},${VH*0.02}`,
      hx:VW*0.76, hy:VH*0.02, hdx:6, hdy:-4 },
  ];
  vicArrows.forEach(a=>{
    // Arrow shaft
    const path = document.createElementNS(ns,'path');
    path.setAttribute('id', a.id);
    path.setAttribute('d', a.d);
    path.setAttribute('stroke','#2255cc');
    path.setAttribute('stroke-width','5');
    path.setAttribute('fill','none');
    path.setAttribute('stroke-linecap','round');
    path.setAttribute('stroke-linejoin','round');
    path.setAttribute('filter','url(#ink-bleed)');
    path.style.mixBlendMode = 'multiply';
    path.style.opacity = '0';
    path.style.transition = 'opacity .5s ease';
    // Compute dash length
    path.style.strokeDasharray = '280';
    path.style.strokeDashoffset = '280';
    svg.appendChild(path);

    // Arrowhead triangle
    const poly = document.createElementNS(ns,'polygon');
    poly.setAttribute('id', a.id+'-head');
    const tx=a.hx, ty=a.hy;
    const len2=Math.sqrt(a.hdx*a.hdx+a.hdy*a.hdy)||1;
    const ux2=a.hdx/len2, uy2=a.hdy/len2;
    const px2=-uy2, py2=ux2;
    const sz2=16;
    const pts2=`${tx},${ty} ${tx-ux2*sz2+px2*sz2*0.5},${ty-uy2*sz2+py2*sz2*0.5} ${tx-ux2*sz2-px2*sz2*0.5},${ty-uy2*sz2-py2*sz2*0.5}`;
    poly.setAttribute('points', pts2);
    poly.setAttribute('fill','#2255cc');
    poly.setAttribute('filter','url(#ink-bleed)');
    poly.style.mixBlendMode = 'multiply';
    poly.style.opacity = '0';
    poly.style.transition = 'opacity .4s ease 0.8s';
    svg.appendChild(poly);
  });

  /* ── FRENCH FLAG (victory) — bigger, planted near Paris ── */
  const flagG = document.createElementNS(ns,'g');
  flagG.setAttribute('id','french-flag');
  flagG.setAttribute('opacity','0');
  flagG.style.transition = 'opacity .8s ease';
  const flagX = Math.round(VW*0.574) + 22;
  const flagY = Math.round(VH*0.294);
  const fw=72, fh=48;
  // Pole
  const pole = document.createElementNS(ns,'line');
  pole.setAttribute('x1', flagX+''); pole.setAttribute('y1', (flagY+8)+'');
  pole.setAttribute('x2', flagX+''); pole.setAttribute('y2', (flagY-fh-2)+'');
  pole.setAttribute('stroke','rgba(220,200,160,0.95)'); pole.setAttribute('stroke-width','2.5');
  flagG.appendChild(pole);
  // Tricolor
  [['#0032A0',0],['#FFFFFF',fw/3],['#EF4135',fw*2/3]].forEach(([c,ox])=>{
    const r = document.createElementNS(ns,'rect');
    r.setAttribute('x',(flagX+ox)+''); r.setAttribute('y',(flagY-fh)+'');
    r.setAttribute('width',(fw/3+1)+''); r.setAttribute('height',fh+'');
    r.setAttribute('fill',c); r.setAttribute('opacity','0.92');
    flagG.appendChild(r);
  });
  // Border
  const fb=document.createElementNS(ns,'rect');
  fb.setAttribute('x',flagX+''); fb.setAttribute('y',(flagY-fh)+'');
  fb.setAttribute('width',fw+''); fb.setAttribute('height',fh+'');
  fb.setAttribute('fill','none'); fb.setAttribute('stroke','rgba(0,0,0,0.4)'); fb.setAttribute('stroke-width','1');
  flagG.appendChild(fb);
  svg.appendChild(flagG);

  /* ── ENEMY FLAGS ── Prussia (top-right), Austria (right), Britain (top) ── */
  function mkFlag(id, x, y, stripes, opacity){
    const g = document.createElementNS(ns,'g');
    g.setAttribute('id',id); g.setAttribute('opacity','0');
    g.style.transition='opacity .6s ease';
    const efw=52, efh=34;
    // Pole
    const ep=document.createElementNS(ns,'line');
    ep.setAttribute('x1',x+''); ep.setAttribute('y1',(y+6)+'');
    ep.setAttribute('x2',x+''); ep.setAttribute('y2',(y-efh)+'');
    ep.setAttribute('stroke','rgba(160,130,90,0.7)'); ep.setAttribute('stroke-width','1.5');
    g.appendChild(ep);
    // Flag stripes
    stripes.forEach((s,si)=>{
      const r=document.createElementNS(ns,'rect');
      const sh = efh/stripes.length;
      r.setAttribute('x',x+''); r.setAttribute('y',(y-efh+si*sh)+'');
      r.setAttribute('width',efw+''); r.setAttribute('height',(sh+1)+'');
      r.setAttribute('fill',s); r.setAttribute('opacity','0.88');
      g.appendChild(r);
    });
    // Border
    const eb=document.createElementNS(ns,'rect');
    eb.setAttribute('x',x+''); eb.setAttribute('y',(y-efh)+'');
    eb.setAttribute('width',efw+''); eb.setAttribute('height',efh+'');
    eb.setAttribute('fill','none'); eb.setAttribute('stroke','rgba(0,0,0,0.35)'); eb.setAttribute('stroke-width','1');
    g.appendChild(eb);
    return g;
  }
  // Prussia — black/white horizontal stripes
  const prussiaFlag = mkFlag('flag-prussia', Math.round(VW*0.84), Math.round(VH*0.18), ['#1a1a1a','#e8e0cc','#1a1a1a']);
  svg.appendChild(prussiaFlag);
  // Austria — red/white/red horizontal
  const austriaFlag = mkFlag('flag-austria', Math.round(VW*0.84), Math.round(VH*0.48), ['#CC0000','#F5F0E8','#CC0000']);
  svg.appendChild(austriaFlag);
  // Britain — blue/red/blue vertical (simplified union jack feel)
  const britainFlag = mkFlag('flag-britain', Math.round(VW*0.36), Math.round(VH*0.17), ['#012169','#C8102E','#012169']);
  svg.appendChild(britainFlag);

  /* ── PARIS DOT + LABELS ── */
  const PARIS_CX = Math.round(VW*0.574); // 686
  const PARIS_CY = Math.round(VH*0.294); // 292

  const parisDot = document.createElementNS(ns,'circle');
  parisDot.setAttribute('cx', PARIS_CX+'');
  parisDot.setAttribute('cy', PARIS_CY+'');
  parisDot.setAttribute('r','7');
  parisDot.setAttribute('class','paris-dot');
  parisDot.id = 'paris-dot';
  svg.appendChild(parisDot);

  // Paris label — large, gold, visible
  const parisLbl = document.createElementNS(ns,'text');
  parisLbl.setAttribute('x', (PARIS_CX+14)+'');
  parisLbl.setAttribute('y', (PARIS_CY+6)+'');
  parisLbl.setAttribute('fill','rgba(220,200,160,0.95)');
  parisLbl.setAttribute('font-family','Cormorant Garamond, Georgia, serif');
  parisLbl.setAttribute('font-size','28');
  parisLbl.setAttribute('font-weight','700');
  parisLbl.setAttribute('letter-spacing','3');
  parisLbl.setAttribute('paint-order','stroke');
  parisLbl.setAttribute('stroke','rgba(0,0,0,0.7)');
  parisLbl.setAttribute('stroke-width','4');
  parisLbl.id = 'lbl-paris-svg';
  parisLbl.textContent = 'PARIS';
  svg.appendChild(parisLbl);

  const mapLabels = [
    {id:'lbl-prussia', text:'PRUSSIA', x:Math.round(VW*0.84), y:Math.round(VH*0.08), col:'rgba(180,40,40,0)', size:22},
    {id:'lbl-austria', text:'AUSTRIA', x:Math.round(VW*0.84), y:Math.round(VH*0.38), col:'rgba(180,40,40,0)', size:22},
    {id:'lbl-british', text:'BRITAIN', x:Math.round(VW*0.36), y:Math.round(VH*0.07), col:'rgba(180,40,40,0)', size:20},
    {id:'lbl-expand',  text:'FRANCE EXPANDS →', x:Math.round(VW*0.55), y:Math.round(VH*0.95), col:'rgba(0,80,180,0)', size:18},
  ];
  mapLabels.forEach(lb=>{
    const t = document.createElementNS(ns,'text');
    t.setAttribute('x', lb.x+''); t.setAttribute('y', lb.y+'');
    t.setAttribute('fill', lb.col);
    t.setAttribute('font-family','Cormorant Garamond, Georgia, serif');
    t.setAttribute('font-size', lb.size+'');
    t.setAttribute('font-weight','700');
    t.setAttribute('letter-spacing','2');
    t.setAttribute('paint-order','stroke');
    t.setAttribute('stroke','rgba(0,0,0,0.6)');
    t.setAttribute('stroke-width','3');
    t.id = lb.id; t.style.transition='fill .7s ease';
    t.textContent = lb.text;
    svg.appendChild(t);
  });

  // Valmy battle star (where the decisive battle happened)
  // Valmy is ~east-center France, roughly x:830, y:310
  const valmyStar = document.createElementNS(ns,'text');
  valmyStar.setAttribute('x', Math.round(VW*0.694)+'');
  valmyStar.setAttribute('y', Math.round(VH*0.315)+'');
  valmyStar.setAttribute('fill','rgba(200,184,154,0)');
  valmyStar.setAttribute('font-size','24');
  valmyStar.id='lbl-valmy';
  valmyStar.style.transition='fill .6s ease 1s';
  valmyStar.textContent='★ Valmy 1792';
  valmyStar.setAttribute('font-family','Cormorant Garamond, Georgia, serif');
  svg.appendChild(valmyStar);

  stack.appendChild(svg);

  // Layer 3: tactical vignette
  const vig = el('div','map-vignette'); stack.appendChild(vig);

  return stack;
}

