/* ══════════════════════════════════════════════════════════
   LENIS SMOOTH SCROLL
   Heavy museum physics: lerp 0.05, duration 1.8s
══════════════════════════════════════════════════════════ */
const lenis = new Lenis({
  duration: 2.4,
  easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
  smoothWheel: true,
  wheelMultiplier: 0.55,
});

lenis.on('scroll', onScroll);

function raf(time){ lenis.raf(time); requestAnimationFrame(raf); }
requestAnimationFrame(raf);

/* ══════════════════════════════════════════════════════════
   SCROLL HANDLER — scrub-based, tied to position
══════════════════════════════════════════════════════════ */
function onScroll({ scroll, limit }){
  // Progress bar
  document.getElementById('pb').style.width = (scroll/limit*100)+'%';

  const vh = window.innerHeight;
  let activeChapter = '';

  // Fullscreen scenes
  main.querySelectorAll('.fs').forEach(sec => {
    const top = sec.getBoundingClientRect().top;
    const bottom = top + sec.offsetHeight;
    const entering = top < vh*.78 && bottom > vh*.18;
    sec.querySelectorAll('.sr').forEach(e => {
      e.classList.toggle('in', entering);
      if(!entering && bottom < vh*.1) e.classList.add('out');
      else e.classList.remove('out');
    });
    if(top < vh*.65 && bottom > vh*.35) activeChapter = sec.dataset.ch;
  });

  // Exhibit + map chapters
  main.querySelectorAll('.ch').forEach(ch => {
    const rect = ch.getBoundingClientRect();
    const scrollInCh = -rect.top;
    const stopH = STOP_H();
    const stopIdx = Math.max(0, Math.min(Math.floor(scrollInCh / stopH), 10));
    const sci = parseInt(ch.dataset.sci);
    const sc = STORY[sci];
    if(!sc||!sc.stops) return;
    const clamp = Math.min(stopIdx, sc.stops.length-1);

    // Sub-scroll progress within current stop (0.0 → 1.0)
    const stopStart = clamp * stopH;
    const subProgress = Math.max(0, Math.min((scrollInCh - stopStart) / stopH, 1));

    if(rect.top < vh*.6 && rect.bottom > vh*.4) activeChapter = ch.dataset.ch;

    sc.stops.forEach((_,si)=>{
      const card = document.getElementById('card-'+sci+'-'+si);
      if(card){
        const active = si===clamp;
        card.classList.toggle('on', active);
        if(active){
          // FIX 2: Sentence-by-sentence reveal tied to sub-scroll progress
          const sents = card.querySelectorAll('.a-sent');
          if(sents.length){
            sents.forEach((s,i)=>{
              const threshold = i / (sents.length + 1);
              s.classList.toggle('in', subProgress > threshold);
            });
          }
          // Names list: reveal one by one with scroll
          const nameRows = card.querySelectorAll('.name-row');
          if(nameRows.length){
            nameRows.forEach((row,ni)=>{
              const threshold = (ni+1) / (nameRows.length + 2);
              row.classList.toggle('nm-in', subProgress > threshold);
            });
          }
          const scoreKeys = [];
          if(sc.stops[si].scores) scoreKeys.push(sc.stops[si].scores);
          if(sc.stops[si].scores_compare) scoreKeys.push('robespierre_claimed','actual');
          // Get all sc-block elements in this card — one per score key
          const scoreBlocks = card.querySelectorAll('.sc-block');
          scoreKeys.forEach((key,ki)=>{
            const uid = sci+'-'+si+'-'+key;
            if(subProgress > 0.1 + ki*0.05) scored.add(uid);
            if(scored.has(uid)){
              // Target only the fills/nums inside the matching sc-block
              const block = scoreBlocks[ki];
              if(!block) return;
              SCORES[key].rows.forEach((row,ri)=>{
                const fill = block.querySelector('.sc-fill.'+row.k);
                const num  = block.querySelector('.sc-num.'+row.k);
                const barProgress = Math.max(0, Math.min((subProgress - 0.1 - ki*0.05 - ri*0.08) / 0.35, 1));
                if(fill) fill.style.width = (barProgress * row.v) + '%';
                if(num)  num.textContent = Math.round(barProgress * row.v);
              });
            }
          });
        }
      }
    });

    // FIX 1: Per-stop artifact crossfade
    if(sc.type==='exhibit'){
      const af = ch.querySelector('.artifact-frame');
      if(af){
        const currentArt = sc.stops[clamp]?.art;
        af.querySelectorAll('.artifact-img').forEach(img=>{
          img.classList.toggle('show', img.dataset.artSrc === currentArt);
        });
      }
    }

    // War-mixed: toggle between map and painting per stop kind
    if(sc.type==='war-mixed'){
      const stop = sc.stops[clamp];
      const mapScene = ch.querySelector('#war-map-scene');
      const artFrame = ch.querySelector('#war-artifact-frame');
      const spEl = document.getElementById('sp-'+sci);

      if(stop.kind==='map'){
        if(mapScene) mapScene.style.opacity='1';
        if(artFrame) artFrame.style.opacity='0';
        if(spEl) spEl.classList.remove('on');
        setMapState(stop.mapState);
        // Scrub frontline position directly with scroll progress
        if(stop.mapState==='invasion' || stop.mapState==='victory'){
          scrubFrontline(stop.mapState, subProgress);
        }
      } else if(stop.kind==='exhibit'){
        if(mapScene) mapScene.style.opacity='0';
        if(artFrame){
          artFrame.style.opacity='1';
          artFrame.querySelectorAll('.artifact-img').forEach(img=>{
            img.classList.toggle('show', img.dataset.artSrc === stop.art);
          });
        }
        if(spEl && stop.sp){
          const s=stop.sp;
          spEl.style.cssText=`left:calc(${s.x} - ${s.w/2}px);top:calc(${s.y} - ${s.h/2}px);width:${s.w}px;height:${s.h}px;opacity:1;`;
          spEl.classList.add('on');
        }
      }
    }

    // Spotlight
    const spEl = document.getElementById('sp-'+sci);
    if(spEl && sc.stops[clamp]?.sp){
      const s=sc.stops[clamp].sp;
      spEl.style.cssText=`left:calc(${s.x} - ${s.w/2}px);top:calc(${s.y} - ${s.h/2}px);width:${s.w}px;height:${s.h}px;opacity:1;`;
      spEl.classList.add('on');
    }

    // Side images
    sc.stops.forEach((stop,si)=>{
      if(!stop.side) return;
      const img = document.getElementById('si-'+sci+'-'+si);
      if(img) img.classList.toggle('show', si===clamp);
    });

    // Map state
    if(sc.type==='map' && sc.stops[clamp]){
      setMapState(sc.stops[clamp].mapState);
    }
  });

  updateTL(activeChapter);
}

/* ── MAP STATE + SCRUB ── */
function setMapState(state){
  if(state===mapState) return;
  mapState=state;

  const setFill = (id,val)=>{ const e=document.getElementById(id); if(e) e.setAttribute('fill',val); };
  const setOp   = (id,val)=>{ const e=document.getElementById(id); if(e) e.setAttribute('opacity',val); };

  setOp('inv-zone','0');
  ['exp-belgium','exp-rhine','exp-savoy'].forEach(id=>setOp(id,'0'));
  ['lbl-prussia','lbl-austria','lbl-british'].forEach(id=>setFill(id,'rgba(180,40,40,0)'));
  setFill('lbl-expand','rgba(0,80,180,0)');
  setFill('lbl-valmy','rgba(200,184,154,0)');
  // Reset arrows
  ['varr-ne','varr-e','varr-se','varr-n','iarr-prussia','iarr-austria','iarr-britain','iarr-south'].forEach(id=>{
    const e=document.getElementById(id); if(e){e.style.opacity='0';e.style.strokeDashoffset='280';}
    const h=document.getElementById(id+'-head'); if(h) h.style.opacity='0';
  });
  // Reset flags
  ['french-flag','flag-prussia','flag-austria','flag-britain'].forEach(id=>{
    const e=document.getElementById(id); if(e) e.setAttribute('opacity','0');
  });
  // Reset blue clip
  const vcr=document.getElementById('vic-clip-rect'); if(vcr){vcr.setAttribute('x',(MAP_VW*0.55)+'');vcr.setAttribute('width','0');}
  const pd=document.getElementById('paris-dot'); if(pd) pd.setAttribute('class','paris-dot');
  const pl=document.getElementById('lbl-paris-svg'); if(pl) pl.setAttribute('fill','rgba(220,200,160,0.95)');
  const ms=document.getElementById('map-stack'); if(ms) ms.style.transform='scale(1)';

  if(state==='invasion'){
    setOp('inv-zone','0.32');
    setTimeout(()=>{ ['lbl-prussia','lbl-austria','lbl-british'].forEach(id=>setFill(id,'rgba(180,40,40,0.95)')); },600);
    setTimeout(()=>{
      ['flag-prussia','flag-austria','flag-britain'].forEach(id=>{ const e=document.getElementById(id); if(e) e.setAttribute('opacity','0.9'); });
    },900);
    if(ms) ms.style.transform='scale(1.07)';
  }

  if(state==='victory'){
    // Start with full red — scrubFrontline will animate it away
    setOp('inv-zone','0.42');
    ['lbl-prussia','lbl-austria','lbl-british'].forEach(id=>setFill(id,'rgba(180,40,40,0.45)'));
    ['flag-prussia','flag-austria','flag-britain'].forEach(id=>{ const e=document.getElementById(id); if(e) e.setAttribute('opacity','0.45'); });
    // Invasion arrows hidden at start of victory
    ['iarr-prussia','iarr-austria','iarr-britain','iarr-south'].forEach(id=>{
      const e=document.getElementById(id); if(e){e.style.opacity='0';}
      const h=document.getElementById(id+'-head'); if(h) h.style.opacity='0';
    });
    if(ms) ms.style.transform='scale(1.0)';
  }
}

function scrubFrontline(state, progress){
  const invZone=document.getElementById('inv-zone');
  const parisDot=document.getElementById('paris-dot');
  const parisLbl=document.getElementById('lbl-paris-svg');
  if(!invZone) return;

  if(state==='invasion'){
    invZone.setAttribute('opacity',(progress*0.35).toFixed(3));
    const danger=progress>0.6;
    if(parisDot) parisDot.setAttribute('class',danger?'paris-dot danger':'paris-dot');
    if(parisLbl) parisLbl.setAttribute('fill',danger?'rgba(220,60,60,0.95)':'rgba(220,200,160,0.95)');
    if(progress>0.2){
      const a=Math.min((progress-0.2)/0.3,1);
      ['lbl-prussia','lbl-austria','lbl-british'].forEach(id=>{
        const e=document.getElementById(id); if(e) e.setAttribute('fill',`rgba(180,40,40,${a.toFixed(2)})`);
      });
    }
    // Invasion arrows draw in staggered
    ['iarr-prussia','iarr-austria','iarr-britain','iarr-south'].forEach((id,i)=>{
      const arrEl=document.getElementById(id);
      const headEl=document.getElementById(id+'-head');
      const arrP=Math.max(0,Math.min((progress-0.1-i*0.1)/0.4,1));
      if(arrEl){ arrEl.style.opacity=arrP>0?'0.85':'0'; arrEl.style.strokeDashoffset=(260*(1-arrP))+''; }
      if(headEl) headEl.style.opacity=arrP>0.8?'0.85':'0';
    });
  }

  if(state==='victory'){
    const redOp = Math.max(0, 0.42 - progress * 0.84);
    invZone.setAttribute('opacity', redOp.toFixed(3));
    // Enemy labels and flags fade out
    ['lbl-prussia','lbl-austria','lbl-british'].forEach(id=>{
      const e=document.getElementById(id);
      if(e) e.setAttribute('fill',`rgba(180,40,40,${Math.max(0,0.45-progress*0.9).toFixed(2)})`);
    });
    ['flag-prussia','flag-austria','flag-britain'].forEach(id=>{
      const e=document.getElementById(id);
      if(e) e.setAttribute('opacity', Math.max(0, 0.45-progress*0.9).toFixed(2));
    });

    const blueStart = 0.15;
    if(progress > blueStart){
      const blueP = Math.min((progress - blueStart) / 0.7, 1);
      const clipX = MAP_VW * 0.55;
      const clipW = blueP * MAP_VW * 0.5;
      const vcr = document.getElementById('vic-clip-rect');
      if(vcr){ vcr.setAttribute('x', clipX+''); vcr.setAttribute('width', clipW+''); }

      const blueOp = Math.min(blueP * 0.55, 0.42).toFixed(3);
      ['exp-belgium','exp-rhine','exp-savoy'].forEach(id=>{
        const e=document.getElementById(id); if(e) e.setAttribute('opacity', blueOp);
      });

      // Arrows staggered
      ['varr-ne','varr-e','varr-se','varr-n'].forEach((id,i)=>{
        const arrEl = document.getElementById(id);
        const headEl = document.getElementById(id+'-head');
        const arrP = Math.max(0, Math.min((blueP - i*0.12) / 0.4, 1));
        if(arrEl){ arrEl.style.opacity = arrP > 0 ? '0.9' : '0'; arrEl.style.strokeDashoffset = (280*(1-arrP))+''; }
        if(headEl) headEl.style.opacity = arrP > 0.7 ? '0.9' : '0';
      });

      // France flag appears when blue is well advanced
      const flagEl = document.getElementById('french-flag');
      if(flagEl) flagEl.setAttribute('opacity', blueP > 0.6 ? Math.min((blueP-0.6)/0.3, 0.95).toFixed(2) : '0');

      const lblExp=document.getElementById('lbl-expand');
      if(lblExp) lblExp.setAttribute('fill',`rgba(60,120,220,${Math.min(blueP*1.2,0.9).toFixed(2)})`);
      const lblVal=document.getElementById('lbl-valmy');
      if(lblVal) lblVal.setAttribute('fill',`rgba(200,184,154,${Math.min(blueP*1.5,0.85).toFixed(2)})`);
    }
  }
} // end scrubFrontline (now scroll-driven in onScroll, countUp kept for reference) ── */
function countUp(el,target,dur){
  const t0=performance.now();
  (function f(now){
    const p=Math.min((now-t0)/dur,1);
    el.textContent=Math.round((1-Math.pow(1-p,3))*target);
    if(p<1) requestAnimationFrame(f); else el.textContent=target;
  })(t0);
}

/* ── TIMELINE ── */
let lastCh='';
function updateTL(active){
  if(active===lastCh) return; lastCh=active;
  const idx=CHS.findIndex(c=>c.id===active);
  CHS.forEach((ch,i)=>{
    document.getElementById('tld-'+ch.id)?.classList.toggle('on',i===idx);
    document.getElementById('tld-'+ch.id)?.classList.toggle('done',i<idx);
    document.getElementById('tll-'+ch.id)?.classList.toggle('on',i===idx);
    const cf=document.getElementById('tlcf-'+ch.id);
    if(cf) cf.style.height=i<idx?'100%':i===idx?'50%':'0%';
  });
}

/* ── LANGUAGE ── */
function setLang(l){
  lang=l;
  document.querySelectorAll('.lb').forEach(b=>b.classList.toggle('on',b.textContent.trim()===(l==='en'?'EN':'日本語')));
  document.querySelectorAll('[data-en]').forEach(e=>{
    const v=e.getAttribute('data-'+l); if(v!==null) e.innerHTML=v;
  });
}

/* ── CHOICE ── */
function pickChoice(k){
  if(choiceMade) return; choiceMade=true;
  const opt=CHOICE.opts.find(o=>o.k===k);
  CHOICE.opts.forEach(o=>{
    const b=document.getElementById('co-'+o.k); if(!b) return;
    if(o.correct) b.classList.add('correct');
    else if(o.k!==k) b.classList.add('dimmed');
    b.style.pointerEvents='none';
  });
  const ans=document.getElementById('ch-ans');
  if(ans){ans.textContent=opt.ans[lang]||opt.ans.en; ans.classList.add('show');}
}

/* ── RESIZE ── */
window.addEventListener('resize',()=>{
  main.querySelectorAll('.ch[data-type]').forEach(ch=>{
    const sci=parseInt(ch.dataset.sci);
    const sc=STORY[sci];
    if(sc?.stops) ch.style.height=(sc.stops.length*STOP_H()+window.innerHeight)+'px';
  });
});
/* ── INIT ── */
window.addEventListener('load',()=>{
  setLang('en');
  // First scene in
  setTimeout(()=>{
    document.querySelectorAll('.fs:first-child .sr').forEach((e,i)=>{
      setTimeout(()=>e.classList.add('in'),500+i*180);
    });
  },200);
  // Mark score blocks with their key for detection
  document.querySelectorAll('.sc-block').forEach(b=>{
    const card=b.closest('.anno-card'); if(!card) return;
    const id=card.id; // card-scIdx-si
    const parts=id.split('-');
    const sci=parseInt(parts[1]); const si=parseInt(parts[2]);
    const sc=STORY[sci]; if(!sc?.stops?.[si]?.scores) return;
    b.dataset.scoreKey=sc.stops[si].scores;
  });
});
